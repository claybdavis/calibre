'''
granta.com
'''
import re

from calibre.web.feeds.news import BasicNewsRecipe


class Granta(BasicNewsRecipe):

    title = u'Granta'
    description = u'The Magazine of New Writing'
    language = 'en'

    __author__ = 'Gary Arnold'

    browser_type = 'webengine'
    oldest_article = 90
    max_articles_per_feed = 50
    use_embedded_content = True
    no_stylesheets = True
    remove_javascript = True
    auto_cleanup = False

    # The granta.com WordPress RSS feed paginates with 10 items per page and embeds
    # full article HTML in <content:encoded>. Fetching the feed avoids the Cloudflare
    # Managed Challenge that gates /issues, per-issue pages, and individual article URLs.
    feeds = [
        ('Granta', 'https://granta.com/feed/'),
        ('Granta (earlier)', 'https://granta.com/feed/?paged=2'),
        ('Granta (earlier still)', 'https://granta.com/feed/?paged=3'),
    ]

    remove_tags = [
        dict(attrs={'class': lambda x: x and 'litbreaker' in ' '.join(x).lower()}),
        dict(name='script'),
        dict(name='noscript'),
    ]

    def get_cover_url(self):
        # Find the latest issue URL from the home page and pull the cover image from
        # the issue page. Two webengine fetches -- few enough that Cloudflare's
        # heuristic typically lets them through.
        try:
            home = self.index_to_soup('https://granta.com/')
        except Exception as e:
            self.log.warning('Granta cover: home page fetch failed: %s' % e)
            return None
        issue_url = None
        for a in home.find_all('a', href=True):
            if re.match(r'^https?://granta\.com/products/granta-\d+', a['href']):
                issue_url = a['href']
                break
        if not issue_url:
            return None
        try:
            issue = self.index_to_soup(issue_url)
        except Exception as e:
            self.log.warning('Granta cover: issue page fetch failed: %s' % e)
            return None
        cover = issue.find('div', class_='single-issue__cover-image')
        if cover is not None and cover.get('data-background'):
            return cover['data-background']
        og = issue.find('meta', attrs={'property': 'og:image'})
        if og and og.get('content'):
            return og['content']
        return None
