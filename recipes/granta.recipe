'''
granta.com
'''
from calibre.web.feeds.news import BasicNewsRecipe


class Granta(BasicNewsRecipe):

    title = u'Granta'
    description = u'The Magazine of New Writing'
    language = 'en'

    __author__ = 'Gary Arnold'

    oldest_article = 90
    max_articles_per_feed = 50
    use_embedded_content = True
    no_stylesheets = True
    remove_javascript = True
    auto_cleanup = False

    # The granta.com WordPress RSS feed paginates with 10 items per page and embeds
    # full article HTML in <content:encoded>. Fetching the feed avoids the Cloudflare
    # Managed Challenge that gates /issues, per-issue pages, and individual article URLs.
    feeds = [
        ('Granta', 'https://granta.com/feed/'),
        ('Granta (earlier)', 'https://granta.com/feed/?paged=2'),
        ('Granta (earlier still)', 'https://granta.com/feed/?paged=3'),
    ]

    remove_tags = [
        dict(attrs={'class': lambda x: x and 'litbreaker' in ' '.join(x).lower()}),
        dict(name='script'),
        dict(name='noscript'),
    ]
